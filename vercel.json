{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git log -1 --name-only | grep -E '^src/|^api/|^package.json|^vite.config.js' > /dev/null",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}